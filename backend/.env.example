# ============ LLM 配置(OpenAI 兼容接口)============
# 不配置 API Key 时系统自动进入降级模式(规则检索 + 示例 SQL 兜底),仍然可以完整演示流程
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60

# ============ 数据库 ============
# 默认使用 SQLite(零配置);生产/演示可切换 MySQL:
# DB_URL="mysql+pymysql://root:password@127.0.0.1:3306/chatbi?charset=utf8mb4"
DB_URL="sqlite:///data/chatbi.db"

# ============ 检索与安全 ============
RETRIEVER_TOP_K=4
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
