# ============ LLM 配置(OpenAI 兼容接口)============
# 不配置 API Key 时系统自动进入降级模式(规则检索 + 示例 SQL 兜底),仍然可以完整演示流程
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60

# ============ 数据库 ============
# 默认使用 SQLite(零配置);生产/演示可切换 MySQL:
# DB_URL="mysql+pymysql://root:password@127.0.0.1:3306/chatbi?charset=utf8mb4"
DB_URL="sqlite:///data/chatbi.db"

# ============ 语义检索后端 ============
# auto: 优先 embedding,初始化失败自动回退 TF-IDF | tfidf: 固定 TF-IDF | embedding: 强制 embedding
EMBEDDING_BACKEND="auto"
# embedding 提供方: local(fastembed 本地 ONNX,首次运行自动下载模型)| api(OpenAI 兼容 /embeddings)
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="BAAI/bge-small-zh-v1.5"
# 使用 API 提供方时填写(如 SiliconFlow 的 BAAI/bge-m3):
# EMBEDDING_API_KEY=""
# EMBEDDING_BASE_URL=""

# ============ 检索与安全 ============
RETRIEVER_TOP_K=4
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
